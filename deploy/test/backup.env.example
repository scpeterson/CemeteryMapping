# Install privately as root-owned mode 0600 /etc/nhcemeteries-backup.env.
# This example has no credentials. Dedicated private Spaces bucket; credentials must be bucket-scoped.
RESTIC_REPOSITORY=s3:https://sfo3.digitaloceanspaces.com/nhcemeteries-test-backups/hosted-test
RESTIC_PASSWORD_FILE=/etc/nhcemeteries-backup/repository-password
# Supply storage credentials using this file or the backend's supported mechanism.
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_SECRET
AWS_DEFAULT_REGION=sfo3
# Cache is disposable, not a recovery copy; monitor its disk usage.
RESTIC_CACHE_DIR=/var/cache/nhcemeteries-restic
